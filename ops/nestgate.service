#
# nestGate systemd user service — template for any gate
# Install: systemctl --user link $PWD/ops/nestgate.service && systemctl --user enable nestgate
#
# Override paths per gate via drop-in or EnvironmentFile:
#   systemctl --user edit nestgate  →  [Service] EnvironmentFile=...

[Unit]
Description=NestGate Storage & Discovery Primal
Documentation=https://sporeprint.primals.eco/nestgate
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=%h/.local/bin/nestgate server --socket-only
EnvironmentFile=-%h/.config/nestgate/env
Restart=on-failure
RestartSec=5
WatchdogSec=30

# Hardening
ProtectSystem=strict
ReadWritePaths=%h/.local/share/nestgate
ReadWritePaths=%t
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
