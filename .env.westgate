# westGate Nest Atomic Configuration — Wave 155i
# ZFS-backed CAS with 5-tier substrate discovery
# Hardware: 1.8TB NVMe (warm) + 25.4TB ZFS mirrors + 2TB L2ARC (cold)
# Aligned with live composition (family: westgate-tower-155f, 8 services)

# ── Identity ─────────────────────────────────────────────────────────────
NESTGATE_GATE_ID=westgate
NESTGATE_FAMILY_ID=westgate-tower-155f

# ── Storage ──────────────────────────────────────────────────────────────
NESTGATE_STORAGE_PATH=/mnt/nestgate/cold/zfs/cas
NESTGATE_STORAGE_BACKEND=zfs
NESTGATE_STORAGE_QUOTA_GB=20000
NESTGATE_STORAGE_RETENTION_DAYS=365

# ── ZFS Pool & CAS ──────────────────────────────────────────────────────
NESTGATE_ZFS_POOL=nestgate
NESTGATE_ZFS_CAS_DATASET=nestgate/cas
NESTGATE_ZFS_ALLOW_MUTATIONS=true

# ── Substrate Tiers ──────────────────────────────────────────────────────
NESTGATE_SUBSTRATE_BASE=/mnt/nestgate
NESTGATE_WARM_PATHS=/mnt/nestgate/warm/nvme
NESTGATE_COLD_PATHS=/mnt/nestgate/cold/zfs

# ── Network (composition mode — UDS primary, TCP alongside) ──────────────
NESTGATE_API_PORT=8080
NESTGATE_BIND_ADDRESS=127.0.0.1

# ── Ecosystem ────────────────────────────────────────────────────────────
ECOSYSTEM_NAME=biomeos
BIOMEOS_SOCKET_DIR=/run/user/1000/biomeos

# ── Logging ──────────────────────────────────────────────────────────────
RUST_LOG=nestgate=info,nestgate_rpc=info,nestgate_zfs=info
NESTGATE_LOG_LEVEL=info
